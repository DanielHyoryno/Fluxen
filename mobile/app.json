{
  "expo": {
    "name": "Fluxen",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./AppLogo/FluxenLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./AppLogo/FluxenLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielhyoryno.fluxen",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to discover and configure water meter IoT devices.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to communicate with water meter IoT devices."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./AppLogo/FluxenLogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.danielhyoryno.fluxen"
    },
    "web": {
      "favicon": "./AppLogo/FluxenLogo.png"
    },
    "plugins": [
      "react-native-ble-plx",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "b7c25677-4eaf-4dea-95cf-a1a077c409ad"
      }
    },
    "owner": "danielhyoryno"
  }
}
