{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fluxen.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_MOBILE": "https://fluxen.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_WEB": "https://fluxen.onrender.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://fluxen.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_MOBILE": "https://fluxen.onrender.com/api/v1",
        "EXPO_PUBLIC_API_BASE_URL_WEB": "https://fluxen.onrender.com/api/v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
