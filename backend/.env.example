PORT=8080
NODE_ENV=development

# For Supabase/Render deployment prefer DATABASE_URL.
# Example: postgresql://postgres:yourpassword@db.xxxyyyzzz.supabase.co:5432/postgres
# For Render deployment, prefer Supabase Session/Transaction Pooler URL instead of the direct host.
# DATABASE_URL=
DB_SSL=false
DB_SCHEMA=public

DB_HOST=localhost
DB_PORT=5432
DB_USER=skripsi_user
DB_PASSWORD=skripsi_pass
DB_NAME=skripsi_db

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d
BUSINESS_TIMEZONE=Asia/Jakarta

# Enable only after applying sql/migrations/004_push_subscription.sql.
PUSH_NOTIFICATIONS_ENABLED=false
# Optional: required if enhanced push security is enabled in EAS. Never expose in mobile env.
EXPO_ACCESS_TOKEN=

# Apply migrations 005 and 006 before enabling account email or password recovery.
ACCOUNT_EMAIL_ENABLED=false
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_OTP_SECRET=
RESEND_API_KEY=
REPORT_EMAIL_FROM=

# Firebase Auth uses hosted email links, not Resend. Enable after migration 007
# and upgrading the mobile app. Keep credentials in Render secrets only.
FIREBASE_AUTH_ENABLED=false
FIREBASE_AUTH_PROJECT_ID=
FIREBASE_AUTH_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/fluxen-firebase-auth.json
